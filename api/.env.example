PORT=3000
NODE_ENV=development

DATABASE_URL=mysql://root:RootPass123!@host:3307/versionly_db

JWT_ACCESS_SECRET=accessSecret123!
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=refreshSecret123!
